# Copy this file to .env and fill in real values.
# Get these from: Supabase Dashboard → your project → Project Settings → API
# The anon key is safe to expose in a browser bundle — it is public by
# design. Real access control lives in Postgres RLS (see
# supabase/security_hardening.sql), not in keeping this key secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
